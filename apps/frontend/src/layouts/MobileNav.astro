---
import Menu from "@lucide/astro/icons/menu";
import X from "@lucide/astro/icons/x";

import NavLinks from "./NavLinks.astro";
---

<div class="lg:hidden flex justify-between items-center bg-navy-900 p-4 text-white">
  <p class="font-bold text-xl uppercase">
    <a href="/" class="p-2">
      World Cup 2026
    </a>
  </p>
  <button
    popovertarget="mobile-nav"
    aria-label="Open menu"
    popovertargetaction="show"
    class="hover:bg-navy-800 p-2 rounded-sm"
  >
    <Menu class="size-6" />
  </button>
</div>

<div
  id="mobile-nav"
  popover
  class="lg:hidden bg-navy-900 backdrop:bg-black/50 m-0 p-4 w-64 h-dvh text-white"
>
  <button
    popovertarget="mobile-nav"
    aria-label="Close menu"
    popovertargetaction="hide"
    class="hover:bg-navy-800 p-2 rounded-sm"
  >
    <X class="size-6" />
  </button>
  <NavLinks />
</div>
