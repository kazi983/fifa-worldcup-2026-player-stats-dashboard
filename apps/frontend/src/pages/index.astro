---
import { API_BASE_URL } from "astro:env/server";
import { getPageItems } from "../lib/pagination.ts";
import Layout from "../layouts/Layout.astro";
import Search from "@lucide/astro/icons/search";
import Funnel from "@lucide/astro/icons/funnel";
import Plus from "@lucide/astro/icons/plus";
import ChevronRight from "@lucide/astro/icons/chevron-right";
import ChevronLeft from "@lucide/astro/icons/chevron-left";
import ChevronUp from "@lucide/astro/icons/chevron-up";
import ChevronDown from "@lucide/astro/icons/chevron-down";
import ChevronsUpDown from "@lucide/astro/icons/chevrons-up-down";

const LIMIT_OPTIONS = [10, 25, 50, 100];
const STAGES = [
  "Third Place Match",
  "Quarter Finals",
  "Final",
  "Semi Finals",
  "Round of 16",
  "Round of 32",
];
type Position = {
  full_name: string;
  short_name: string;
};
const POSITIONS: Position[] = [
  { full_name: "Goalkeeper", short_name: "GK" },
  { full_name: "Defender", short_name: "DF" },
  { full_name: "Midfielder", short_name: "MF" },
  { full_name: "Forward", short_name: "FW" },
];

type Performance = {
  id: string;
  player_name: string;
  team: string;
  jersey_number: number;
  position: string;
  match_date: string;
  opponent_team: string;
  minutes_played: number;
  goals: number;
  assists: number;
  shots: number;
  pass_accuracy: number;
  player_rating: number;
};
type PerformanceData = {
  data: Performance[];
  page: number;
  limit: number;
  total: number;
  totalPages: number;
};
type Column = {
  key: keyof Performance;
  label: string;
};
const COLUMNS: Column[] = [
  { key: "player_name", label: "Player" },
  { key: "team", label: "Team" },
  { key: "opponent_team", label: "Opponent" },
  { key: "match_date", label: "Match Date" },
  { key: "position", label: "Position" },
  { key: "minutes_played", label: "Min" },
  { key: "goals", label: "Goals" },
  { key: "assists", label: "Assists" },
  { key: "shots", label: "Shots" },
  { key: "pass_accuracy", label: "Pass Accuracy" },
  { key: "player_rating", label: "Rating" },
];

function pageHref(page: number) {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.set("page", String(page));
  return `?${params}`;
}

function sortHref(sortColumn: string) {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.delete("page");
  params.set("sort", sortColumn);
  if (selectedSort === sortColumn && selectedOrder === "asc") {
    params.set("order", "desc");
  } else {
    params.set("order", "asc");
  }
  return `?${params}`;
}

let performances: PerformanceData = {
  data: [],
  page: 1,
  limit: 25,
  total: 0,
  totalPages: 0,
};
let teams: string[] = [];
await Promise.all([
  fetch(`${API_BASE_URL}/api/performances${Astro.url.search}`)
    .then((res) => {
      if (!res.ok) {
        throw new Error(`HTTP error! Status: ${res.status}`);
      }
      return res.json();
    })
    .then((parsed) => {
      performances = parsed;
    })
    .catch((error) => {
      console.error("Error fetching performances data:", error);
    }),
  fetch(`${API_BASE_URL}/api/teams`)
    .then((res) => {
      if (!res.ok) {
        throw new Error(`HTTP error! Status: ${res.status}`);
      }
      return res.json();
    })
    .then((parsed) => {
      teams = parsed;
    })
    .catch((error) => {
      console.error("Error fetching teams data:", error);
    }),
]);

const { data, page: currentPage, limit, total, totalPages } = performances;
const pageItems = getPageItems(currentPage, totalPages);
const start = (currentPage - 1) * limit + 1;
const end = Math.min(total, currentPage * limit);
const selectedQ = Astro.url.searchParams.get("q") ?? "";
const selectedLimit = Astro.url.searchParams.get("limit") ?? "25";
const selectedTeam = Astro.url.searchParams.get("team");
const selectedStage = Astro.url.searchParams.get("stage");
const selectedPosition = Astro.url.searchParams.get("position");
const selectedSort = Astro.url.searchParams.get("sort");
const selectedOrder =
  Astro.url.searchParams.get("order") === "asc" ? "asc" : "desc";
---

<Layout title="Player Performances">
  <header class="flex flex-wrap items-center gap-4 pb-5 border-slate-200 border-b">
    <h1 class="font-bold text-2xl lg:text-3xl">Player Performances</h1>
    <form
      id="filters"
      class="flex lg:flex-1 gap-2 order-last lg:order-0 w-full lg:w-auto"
    >
      <div class="relative flex-1 lg:max-w-md">
        <Search class="top-1/2 left-3 absolute size-5 text-slate-400 -translate-y-1/2 pointer-events-none" />
        <label for="q" class="sr-only">
          Search players
        </label>
        <input
          type="search"
          name="q"
          id="q"
          placeholder="Search players..."
          value={selectedQ}
          class="bg-white py-2 pr-3 pl-10 border border-slate-200 rounded-md w-full"
        />
      </div>

      <details class="relative">
        <summary class="[&::-webkit-details-marker]:hidden flex items-center gap-2 bg-white px-3 py-2 border border-slate-200 rounded-md cursor-pointer list-none">
          <Funnel class="size-5" />
          <span class="sr-only sm:not-sr-only">Filters</span>
        </summary>
        <div class="right-0 z-10 absolute flex flex-col gap-3 bg-white shadow-lg mt-2 p-4 border border-slate-200 rounded-md w-64">
          <div>
            <label for="team">Team</label>
            <select
              id="team"
              name="team"
              class="bg-white py-2 pr-3 pl-2 border border-slate-200 rounded-md w-full"
            >
              <option value="">All teams</option>
              {teams.map((team) => (
                <option value={team} selected={team === selectedTeam}>
                  {team}
                </option>
              ))}
            </select>
          </div>
          <div>
            <label for="position">Position</label>
            <select
              id="position"
              name="position"
              class="bg-white py-2 pr-3 pl-2 border border-slate-200 rounded-md w-full"
            >
              <option value="">All positions</option>
              {POSITIONS.map(({ full_name, short_name }) => (
                <option
                  value={full_name}
                  selected={full_name === selectedPosition}
                >
                  {short_name}
                </option>
              ))}
            </select>
          </div>
          <div>
            <label for="stage">Stage</label>
            <select
              id="stage"
              name="stage"
              class="bg-white py-2 pr-3 pl-2 border border-slate-200 rounded-md w-full"
            >
              <option value="">All stages</option>
              {STAGES.map((stage) => (
                <option value={stage} selected={stage === selectedStage}>
                  {stage}
                </option>
              ))}
            </select>
          </div>
          <button
            type="submit"
            class="bg-primary hover:bg-primary-hover py-2 rounded-md text-white"
          >
            Apply
          </button>
        </div>
      </details>
      {selectedSort && (
        <>
          <input type="hidden" name="sort" value={selectedSort} />
          <input type="hidden" name="order" value={selectedOrder} />
        </>
      )}
    </form>

    <a
      href="/performances/new"
      class="flex items-center gap-2 bg-primary hover:bg-primary-hover ml-auto px-4 py-2 rounded-md text-white"
    >
      <Plus class="size-5" />
      <span class="sr-only sm:not-sr-only">Add Performance</span>
    </a>
  </header>

  <div class="flex flex-wrap justify-between items-center gap-4 py-4">
    <label class="flex items-center gap-2">
      Show
      <select
        name="limit"
        id="limit"
        form="filters"
        onchange="this.form.requestSubmit()"
        class="bg-white py-2 pr-3 pl-2 border border-slate-200 rounded-md w-auto"
      >
        {LIMIT_OPTIONS.map((opt) => (
          <option value={opt} selected={String(opt) === selectedLimit}>
            {opt}
          </option>
        ))}
      </select>
      entries
    </label>
    <div class="flex items-center gap-4">
      <p class="text-slate-600 text-sm">
        {total > 0 ? `${start}–${end} of ${total}` : "No results"}
      </p>
      <nav aria-label="Pagination" class="flex gap-2">
        <ul class="flex gap-1">
          <li class="flex items-center">
            {currentPage > 1 ? (
              <a href={pageHref(currentPage - 1)} aria-label="Previous page">
                <ChevronLeft class="size-4" />
              </a>
            ) : (
              <span aria-disabled="true">
                <ChevronLeft class="size-4 text-slate-400" />
              </span>
            )}
          </li>
          {pageItems.map((page) => (
            <li>
              {page === "…" ? (
                "…"
              ) : (
                <a
                  class="flex justify-center items-center bg-white aria-[current=page]:bg-primary hover:bg-slate-100 p-1 border border-slate-300 rounded-md min-w-8 h-8 aria-[current=page]:text-white"
                  aria-current={page === currentPage ? "page" : undefined}
                  href={pageHref(page)}
                >
                  {page}
                </a>
              )}
            </li>
          ))}
          <li class="flex items-center">
            {currentPage < totalPages ? (
              <a href={pageHref(currentPage + 1)} aria-label="Next page">
                <ChevronRight class="size-4" />
              </a>
            ) : (
              <span aria-disabled="true">
                <ChevronRight class="size-4 text-slate-400" />
              </span>
            )}
          </li>
        </ul>
      </nav>
    </div>
  </div>

  <div class="bg-white border border-slate-200 rounded-lg overflow-x-auto">
    <table class="w-full text-sm">
      <caption class="sr-only">Player performances</caption>
      <thead class="bg-slate-50 border-slate-200 border-b-2 text-slate-500 text-xs">
        <tr>
          {COLUMNS.map(({ key, label }) => (
            <th
              scope="col"
              aria-sort={
                selectedSort === key
                  ? selectedOrder === "desc"
                    ? "descending"
                    : "ascending"
                  : undefined
              }
              class="aria-[sort]:text-slate-900 text-left whitespace-nowrap"
            >
              <a
                href={sortHref(key)}
                class="flex items-center gap-1 hover:bg-slate-100 px-3 py-3"
              >
                <span>{label}</span>
                {selectedSort === key ? (
                  selectedOrder === "asc" ? (
                    <ChevronUp class="size-3 text-slate-700" />
                  ) : (
                    <ChevronDown class="size-3 text-slate-700" />
                  )
                ) : (
                  <ChevronsUpDown class="size-3 text-slate-400" />
                )}
              </a>
            </th>
          ))}
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {data.length === 0 ? (
          <tr>
            <td
              colspan={COLUMNS.length}
              class="py-12 text-slate-500 text-center"
            >
              No performances found
            </td>
          </tr>
        ) : (
          data.map((p) => (
            <tr class="relative hover:bg-slate-50 focus-within:bg-slate-50">
              <th scope="row" class="px-4 py-3 text-left whitespace-nowrap">
                <a
                  href={`/performances/edit?id=${encodeURIComponent(p.id)}`}
                  class="after:absolute after:inset-0 focus-visible:outline-none"
                >
                  <div>
                    <p>{p.player_name}</p>
                    <p>#{p.jersey_number}</p>
                  </div>
                </a>
              </th>
              <td class="px-3 py-3 text-left whitespace-nowrap">{p.team}</td>
              <td class="px-3 py-3 text-left whitespace-nowrap">
                {p.opponent_team}
              </td>
              <td class="px-3 py-3 text-left whitespace-nowrap">
                {Intl.DateTimeFormat("en-US", {
                  month: "short",
                  day: "numeric",
                  year: "numeric",
                }).format(new Date(p.match_date))}
              </td>
              <td class="px-3 py-3 text-center whitespace-nowrap">
                {
                  POSITIONS.find(
                    (position) => position.full_name === p.position,
                  )?.short_name
                }
              </td>
              <td class="px-3 py-3 tabular-nums text-center whitespace-nowrap">
                {p.minutes_played}
              </td>
              <td class="px-3 py-3 tabular-nums text-center whitespace-nowrap">
                {p.goals}
              </td>
              <td class="px-3 py-3 tabular-nums text-center whitespace-nowrap">
                {p.assists}
              </td>
              <td class="px-3 py-3 tabular-nums text-center whitespace-nowrap">
                {p.shots}
              </td>
              <td class="px-3 py-3 tabular-nums text-center whitespace-nowrap">
                {p.pass_accuracy * 100}%
              </td>
              <td class="px-3 py-3 tabular-nums text-center whitespace-nowrap">
                <span
                  class:list={[
                    "inline-block px-2 py-0.5 rounded-md font-medium",
                    p.player_rating >= 7
                      ? "bg-rating-good-bg text-rating-good"
                      : p.player_rating >= 6
                        ? "bg-rating-mid-bg text-rating-mid"
                        : "bg-rating-bad-bg text-rating-bad",
                  ]}
                >
                  {Number(p.player_rating).toFixed(1)}
                </span>
              </td>
            </tr>
          ))
        )}
      </tbody>
    </table>
  </div>
</Layout>
