# Copy to .env on the server (never commit .env).
#   cp .env.example .env && chmod 600 .env

# Public hostname. Caddy gets the TLS certificate for it, Astro trusts it.
SITE_HOST=worldcup.kaorukajihara.dev

# Generate with: openssl rand -hex 24
# Hex only: it goes into a postgres:// URL, where symbols would need escaping.
POSTGRES_PASSWORD=
